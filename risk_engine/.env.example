ARVO_RISK_ENGINE_PRIVATE_KEY=0x<dedicated-risk-engine-key>
ARVO_BACKEND_URL=https://api.arvo.example
ARVO_REPORT_PATH=/api/risk-report
ARVO_CALLBACK_SHARED_SECRET=replace-with-a-random-32-byte-secret
# JSON keyed by chainId. Values must match contracts deployed on each chain.
ARVO_CHAIN_PROFILES={"11155111":{"rpc_url":"https://sepolia-rpc.example","verifying_contract":"0x0000000000000000000000000000000000000000","usdc_address":"0x0000000000000000000000000000000000000000","uniswap_quoter_v2_address":"0x0000000000000000000000000000000000000000","uniswap_factory_v3_address":"0x0000000000000000000000000000000000000000","dexscreener_chain":"sepolia","chainlink_feeds":{},"uniswap_fee_tiers":[500,3000,10000]}}
ARVO_REDIS_URL=redis://localhost:6379/0
ARVO_REDIS_STREAM=arvo:trade-intents
ARVO_REDIS_CONSUMER_GROUP=arvo-risk-engine
