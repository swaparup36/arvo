ARVO_RISK_ENGINE_PRIVATE_KEY=0x<dedicated-risk-engine-key>
ARVO_BACKEND_URL=https://api.arvo.example
ARVO_REPORT_PATH=/api/risk-report
ARVO_CHAIN_ID=1
# EIP-712 verifying contract (ArvoMain) on the chain that verifies assessments
ARVO_VERIFYING_CONTRACT=0x0000000000000000000000000000000000000000
ARVO_CALLBACK_SHARED_SECRET=replace-with-a-random-32-byte-secret
ARVO_ONEINCH_API_KEY=replace-with-1inch-api-key
ARVO_RPC_URL=https://your-chain-rpc.example
# Native USDC contract for ARVO_CHAIN_ID; used to value quotes in USDC.
ARVO_USDC_ADDRESS=0x0000000000000000000000000000000000000000
ARVO_DEXSCREENER_CHAIN=ethereum
ARVO_REDIS_URL=redis://localhost:6379/0
ARVO_REDIS_STREAM=arvo:trade-intents
ARVO_REDIS_CONSUMER_GROUP=arvo-risk-engine
# Optional JSON map. Keys and values must be lowercase EVM addresses.
# ARVO_CHAINLINK_FEpython -m arvo_risk_engine.workerEDS={"0xtoken":"0xchainlink-feed"}
