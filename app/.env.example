NODE_ENV=development

# Postgres — matches the docker-compose service below
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Default TTL (seconds) for the read-through cache helper
CACHE_TTL_SECONDS=60

# API secrets
RISK_REPORT_SECRET=
TRADE_CONFIRMATION_SECRET=
JWT_SECRET=

# RPC URLs for different networks
SEPOLIA_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=

BASE_MCP_URL=http://localhost:3000/mcp
BASE_URL=http://localhost:3000

# Contract addresses
ARVO_MAIN_ADDRESS=
VAULT_FACTORY_ADDRESS=
NEXT_PUBLIC_ARVO_MAIN_ADDRESS=${ARVO_MAIN_ADDRESS}
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=${VAULT_FACTORY_ADDRESS}

# Optional API credentials
ALCHEMY_API_KEY=
ONE_INCH_BASE_URL=https://api.1inch.dev
ONE_INCH_API_KEY=

# Private keys
OWNER_PRIVATE_KEY=
